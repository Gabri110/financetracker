# FinanceTracker configuration
# Copy this file to .env and adjust. Every setting is optional.

# Session signing key. Leave unset to have one generated and stored in instance/secret_key.
# SECRET_KEY=

# SQLite database path (Docker uses /data/finance.db)
DATABASE=finance.db

# Folder holding the bank-statement drop folders (raw/<bank>/...). Docker uses /data.
# DATA_DIR=data

# Sync page: Enable Banking (open banking for Bankinter / ING), see INSTALL.md
# The private key must live outside the repository.
# ENABLE_BANKING_APP_ID=
# ENABLE_BANKING_KEY_PATH=
# Optional; defaults to http://localhost:8000/sync/callback
# ENABLE_BANKING_REDIRECT_URL=

# Registration is open only until the first user exists. Set to true to allow more users.
# REGISTRATION_ENABLED=false

# Enable the Flask debugger for `python app.py` (never on a reachable host)
# FLASK_DEBUG=1
